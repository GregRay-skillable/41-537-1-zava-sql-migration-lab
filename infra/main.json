    "onprem_sql_vm_ext": {
      "type": "Microsoft.Compute/virtualMachines/extensions",
      "apiVersion": "2025-04-01",
      "name": "[format('{0}/{1}', format('{0}-vm', variables('onPremSqlVmPrefix')), 'SqlVmConfig')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "properties": {
        "publisher": "Microsoft.Powershell",
        "type": "DSC",
        "typeHandlerVersion": "2.9",
        "autoUpgradeMinorVersion": true,
        "settings": {
          "configuration": {
            "url": "[variables('sqlVmScriptArchiveUrl')]",
            "script": "[variables('sqlVmScriptName')]",
            "function": "Main"
          },
          "configurationArguments": {
            "DbBackupFileUrl": "[variables('databaseBackupFileUrl')]",
            "DatabasePassword": "[parameters('sourceAdminPassword')]"
          }
        }
      },
      "dependsOn": [
        "onprem_sql_vm"
      ]
    }
